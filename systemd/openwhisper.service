[Unit]
Description=OpenWhisper Speech-to-Text Assistant Daemon
After=pipewire.service sound.target

[Service]
Type=simple
ExecStart=%h/.local/bin/openwhisper daemon
ExecStop=%h/.local/bin/openwhisper stop
Restart=on-failure
RestartSec=3
Environment=RUST_LOG=info
PassEnvironment=WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP

[Install]
WantedBy=default.target
